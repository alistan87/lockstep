{
  "format_version": "1.0",
  "name": "map-summarize",
  "description": "Shell discovery emitting a JSON array -> map over items -> harness digest.",
  "nodes": [
    {
      "id": "discover",
      "role": "work",
      "kind": "shell",
      "spec": {
        "cmd": [
          "python",
          "-c",
          "import json,glob; print(json.dumps({'files': sorted(glob.glob('src/lockstep/*.py'))[:3], 'notes': ''}))"
        ]
      },
      "output": "json",
      "contract": "PathManifest"
    },
    {
      "id": "summarize",
      "role": "map",
      "kind": "harness",
      "depends_on": ["discover"],
      "over": "{steps.discover.json.files}",
      "spec": { "task": "Summarize the purpose of the file {item} in two sentences.", "readonly": false },
      "output": "text",
      "concurrency": 1
    },
    {
      "id": "digest",
      "role": "work",
      "kind": "harness",
      "depends_on": ["summarize"],
      "spec": { "task": "Write a one-paragraph digest of these file summaries:\n{steps.summarize.json}" },
      "output": "text",
      "final": true
    }
  ]
}

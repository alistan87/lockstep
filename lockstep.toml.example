# lockstep executor config (SPEC §8.2). An executor entry is an argv template:
# a new harness or a renamed flag is a config edit, never a code change.
# VERIFY flag names against your installed harness (`claude --help` etc.) and
# pin here; `lockstep doctor` checks each stanza actually runs. Run doctor after
# any harness upgrade and on a weekly cadence.
#
# New to driving lockstep (human or agent)? Read, in order:
#   docs/guides/DRIVING-LOCKSTEP.md    - the drive loop, exit-code protocol, run-dir
#                                 diagnosis; paste-ready for your AGENTS.md
#   docs/guides/FLOW-AUTHORING.md      - how to write a *.tg.json (node model,
#                                 verifier trip-wires, interpolation, heal)
#   flows/starter/README.md     - seven verified template flows + caveats
# Authoritative spec: docs/spec/SPEC.md + AMENDMENTS r4-r7 (later wins);
# pi extension rules: docs/spec/ADDENDUM-A-pi-hooks.md.

default = "claude-code"

# [driver] runs_dir (2026-09-19): where run directories live when no
# `--runs-dir` is given — every CLI command and every cockpit tool resolves
# the same way (flag > this key > ./runs). A RELATIVE value is relative to
# THIS file's directory, so the value below is a sibling of the repo: OUTSIDE
# the audited tree, which is the recommended shape — a re-spawned node cannot
# browse prior runs' prompts and diffs, and an un-ignored run dir can never
# trip the resume-time external-edit warning on its own state.json. The
# default stays ./runs so nothing moves until you decide. Never hashed (run
# dirs are excluded from every fingerprint), but this file's whole-file
# digest folds into kind:"flow" nodes, so adding the key re-bills composed
# children once.
# [driver]
# runs_dir = "../lockstep-runs"

[executors.claude-code]                    # personal machine, Claude subscription
# --safe-mode (verified against claude 2.1.270 on 2026-09-19, five live
# controls from this repo root): Claude Code auto-loads CLAUDE.md (cwd +
# parents) AND every `.claude/skills/*` into a headless -p spawn — an
# unhashed instruction channel, same class as pi's AGENTS.md discovery (see
# the pi stanza below). The baseline control saw this repo's CLAUDE.md and
# all five of its skills; `--safe-mode` reduced that to NONE of either, with
# subscription auth intact and a writing spawn under acceptEdits still
# saving its file. What it does NOT remove: the skills bundled with the
# harness itself (code-review, loop, …), which are the harness's own
# behaviour, like its version — recorded, not hashable. Rejected shapes:
# `--bare` also restricts auth to ANTHROPIC_API_KEY (breaks this stanza);
# `--disable-slash-commands` drops the skills but leaves CLAUDE.md loaded;
# `--setting-sources ""` behaves like --safe-mode but by inference, not by
# its documented contract. Adding the flag re-bills claude nodes once
# (argv is hashed, by design). Keep node rules in personas/ and
# spec.context, which are hashed — now the ONLY instruction channels.
# --permission-mode acceptEdits: a headless -p spawn auto-denies its own tool
# permission prompts — without a permission mode, a WRITING node "succeeds" at
# drafting and fails at saving the file (observed live on release-cut's
# changelog node, 2026-09-08). acceptEdits auto-accepts Edit/Write only; the
# driver's write-scope quarantine remains the enforcement layer. Nodes that
# must RUN commands still get denied Bash — escalate that stanza to
# `--permission-mode bypassPermissions` as a deliberate, named decision, never
# as the default.
# --exclude-dynamic-system-prompt-sections (B1, verified against claude
# 2.1.228 --help): moves the per-machine system-prompt sections (cwd, env,
# git status) into the first user message, so the cached prefix survives
# across spawns — lockstep's exact access pattern, N stateless spawns
# against one repo. Only applies with the default system prompt (true
# here). What it buys is CACHE-HIT RATE — latency and usage-limit headroom
# under subscription billing, not dollars; the cost surfaces' `cache:` line
# (G1) is how the claim is measured. Adding the flag re-bills claude nodes
# once (argv is hashed, by design), so in your LIVE lockstep.toml flip it
# only after a baseline run has recorded the `cache:` line to compare
# against, and re-run `lockstep doctor` after flipping.
argv = ["claude", "-p", "{prompt}", "--output-format", "json", "--permission-mode", "acceptEdits",
        "--exclude-dynamic-system-prompt-sections", "--safe-mode"]
prompt_via = "argv"                        # "argv" | "stdin"
json_field = "result"                      # unwrap this envelope field; omit for raw
persona_flag = []                          # empty => prepend persona body to the prompt
readonly_argv = ["--disallowed-tools", "Edit,Write,NotebookEdit,Bash"]  # for spec.readonly nodes;
                                           # absent => readonly nodes error at verify
# schema_argv (C1): appended when a node has output:"json" and a resolvable
# contract; {schema} fills with the CONTRACT's JSON schema (a Name[]
# contract becomes {"type":"array","items":...} — the shape the validator
# will demand), {schema_file} with a path to it in the phase dir. This is
# what kills the ~2.5x corrective re-spawn at the source: the harness is
# constrained to the schema the driver validates against. --json-schema
# exists on claude 2.1.228 (probed via --help); its RUNTIME behaviour on
# your build is doctor's job — probe a contract-bearing node before
# trusting it, and know that enabling this re-bills contract nodes once
# (the filled schema is a new fingerprint part, by design). Inline {schema}
# beside prompt_via="argv" shares one ~32k command line (`verify --lint`
# warns: lint-schema-argv).
# schema_argv = ["--json-schema", "{schema}"]

# B2: the RESILIENT claude stanza — --fallback-model (claude 2.1.228)
# degrades to a weaker model instead of waiting out a 3-minute overload
# retry. A separately NAMED stanza, never the default: a silent model
# downgrade changes what the node is, so a node opts in per `spec.executor`
# when its author prefers "a weaker answer now" over "the right answer in
# three minutes" (status digests, triage — not reviews). The envelope's
# modelUsage is how the cost surfaces keep the downgrade honest; the r5 B2
# retry posture stays the default everywhere else.
[executors.claude-code-resilient]
argv = ["claude", "-p", "{prompt}", "--output-format", "json", "--permission-mode", "acceptEdits",
        "--exclude-dynamic-system-prompt-sections", "--safe-mode",
        "--fallback-model", "claude-sonnet-5"]
prompt_via = "argv"
json_field = "result"
persona_flag = []
readonly_argv = ["--disallowed-tools", "Edit,Write,NotebookEdit,Bash"]

[executors.pi]                             # work machine: pi carries the Copilot login
# pi >= 0.81: JSON output is `--mode json`. `--no-session` keeps doctor probes
# out of the session store; for audit-lineage capture (ADDENDUM-A A.3.4) use
# `"--session-dir", "{phase_dir}"` instead — {phase_dir} expands at spawn (and
# in doctor probes) and stays out of input_hash. Sanctioned only if your pi
# version starts a FRESH session per -p spawn, never resuming from that dir —
# verify after upgrades (ADDENDUM-A preamble note 1). Every spawn also exports
# LOCKSTEP_NODE_ID / _ROLE / _WORKSPACE_SCOPE / _WRITE_SCOPE / _VERDICT_FILE /
# _PHASE_DIR / _CONTRACT / _REPO_ROOT for in-harness enforcement extensions
# (contrib/pi-extension/lockstep-guard.ts). _WRITE_SCOPE is spec.writes as a
# JSON array; _REPO_ROOT is what those relative globs resolve against — an
# extension that resolves them against cwd instead blocks nothing.
#
# `--no-context-files --no-skills` (pi >= 0.83): pi auto-loads AGENTS.md OR
# CLAUDE.md from ~/.pi/agent/, every parent of cwd, AND cwd itself — and a
# node's cwd defaults to the repo root. An auto-discovered file is instruction
# the input_hash cannot see: edit it and every cached result silently stops
# matching what the node was told. Same for discovered skills. These two flags
# close both channels; every pi stanza in this file carries them. Adding them
# to an existing stanza re-bills its nodes once (argv is hashed) — pay it.
argv = ["pi", "-p", "--mode", "json", "--no-session",
        "--no-context-files", "--no-skills", "{prompt}"]
prompt_via = "stdin"                       # not argv: a corrective re-spawn's prompt is
                                           # several times the original and Windows caps
                                           # a command line near 32k (verify --lint says so)
# NO readonly_argv HERE, DELIBERATELY — use `pi-review` below for readonly
# nodes. `--mode json` and the §8.3 STDOUT channel are mutually exclusive, and
# a readonly node has only the stdout channel (FOOTER_READONLY tells it to
# answer in its final response; the tool allowlist removes the write tool it
# would need for a result file).
#
# Measured against pi 0.83.0: `--mode json` is an event STREAM, not one
# envelope. 72 lines of JSONL for a one-word answer, the last of which is
# `{"type":"agent_settled"}` — and that is exactly what the driver's
# `extract_last_json` returns. A readonly `output: "json"` node would validate
# pi's own terminal event against its contract, fail, spend its one corrective
# re-spawn, and fail the node. Writers are unaffected: they answer in
# `result.json` and the file channel wins before stdout is ever read.
#
# Omitting readonly_argv here is what turns that into a LOUD failure: a
# readonly node pointed at this stanza fails `verify` with `readonly-unenforced`
# — free, before anything spawns — instead of failing at runtime after paying
# for the spawn.

# THE READONLY STANZA. Same binary, same model — the ONE difference is that
# `--mode json` is gone, which is what leaves stdout clean enough to be the
# §8.3 result channel. Point every judgement node at this: reviewers,
# arbiters, triage, estimation, planning.
#
# TOOLS ARE PART OF THE STANZA. pi's `--tools` is an argv-visible allowlist,
# which is exactly what SPEC §6.11 requires of readonly enforcement — so
# `spec.readonly: true` is legal on pi, which ADDENDUM-A preamble note 3 had
# parked as an r7 candidate. Verified against pi 0.83.0 with a control:
# unrestricted the model created the file; with the allowlist it did not, while
# still replying "DONE". The allowlist covers EXTENSION tools too, so name
# `submit_result` or the guard extension's own tool disappears; naming a tool
# that is not installed is harmless.
#
# KNOW WHAT THIS GRANTS. pi 0.83.0's built-in tools are exactly: read, edit,
# write, bash, web_search, source_check, fetch_content, get_search_content,
# taskflow. There is no grep, find or ls — bash covers those. So this list
# grants READ AND NOTHING ELSE. (An earlier version of this file said
# `read,grep,find,ls,submit_result`, copied from pi's own --help example;
# three of those five are not tool names, so the list did nothing extra and
# the comment claiming it "turned grep/find/ls on" was wrong.)
#
# That is the intended strength, not an accident: `readonly` is what licenses
# the scheduler to DROP THE TREE TOKEN and run these nodes concurrently, and
# bash is a write vector (`echo x > file`). A stanza that keeps bash while
# excluding write/edit passes verification and still breaks that invariant —
# do not build one. Same reason claude's readonly_argv above excludes Bash,
# not just Edit/Write.
#
# The consequence to design around: a readonly node CANNOT run `git diff` or
# search the repo. Give it what it needs as DATA from a shell node instead —
# `python -m lockstep.probes.worktree_diff` captures the change,
# `python -m lockstep.probes.command_output` captures a command's output.
# flows/starter/implement-heal and bugfix-heal are the worked examples.
#
# Two things this buys beyond safety: readonly nodes drop the `tree` token, so
# reviewers fan out in parallel instead of queueing; and on a request-metered
# plan a node that cannot edit cannot spend a round trip trying to.
#
# The trade this stanza used to state — "no --mode json means no usage
# envelope, because the stream would be read as the answer" — ended
# 2026-09-09: `envelope = "pi-stream"` (D) tells the driver to parse pi's
# JSONL event stream on the §8.3 stdout leg, structurally: the result is
# the last assistant message's text blocks (thinking excluded), the file
# channel still wins for writers, and a stream that settles with no
# assistant text is a NAMED error, never a silent empty result. Reviewers
# now report usage, tool counts and model IDs in every cost surface.
# Adding --mode json re-bills these nodes once (argv is hashed, by
# design). The stream shape is pi's, not ours: after a pi upgrade, re-run
# `lockstep doctor` — its probe exercises this parser end to end.
[executors.pi-review]
argv = ["pi", "-p", "--mode", "json", "--no-session", "--no-context-files", "--no-skills", "{prompt}"]
prompt_via = "stdin"
envelope = "pi-stream"
readonly_argv = ["--tools", "read,submit_result"]

# COPILOT CLI — the stub below runs, but know four things before pointing real
# nodes at it (2026-08-15 review; verify each against YOUR installed copilot
# with `copilot --help`, then `lockstep doctor` — flags drift):
#
# 1. TOOL APPROVAL. Recent copilot builds DENY tool use in programmatic (-p)
#    mode unless approved from argv (--allow-all-tools / --allow-tool /
#    --deny-tool on the builds we have seen). A WRITER node gets the standard
#    footer ("write result.json") — with no approved write tool that is an
#    empty result, one free M4 auto-retry, and a failed node: TWO metered
#    requests for nothing. Probe a writer node with `doctor` before trusting
#    the stanza, and pin whatever approval flags your build takes here.
# 2. NO READONLY SHAPE IS PINNED YET. Every judgement node in the starter
#    flows is `readonly: true`, and without a `readonly_argv` this stanza
#    fails them at verify (`readonly-unenforced` — free, by design). If your
#    build has deny flags, a `copilot-review` stanza with
#    readonly_argv = ["--deny-tool", "write", "--deny-tool", "shell"] (names
#    UNVERIFIED — check them) would make copilot legal for reviewers; record
#    what you verify, the way the pi-review stanza above records its probe.
# 3. REQUEST METERING. A copilot 429 usually means QUOTA, not a blip: the
#    `default_retry` below turns off the harness-kind default (2×60s
#    retries, which burn two more requests against the same wall) for every
#    node on this stanza; a node can still opt back in with its own `retry`
#    (node retry > stanza default_retry > kind default). Scheduling-only:
#    setting or changing it never re-bills a cached node. The driver names
#    quota errors from raw output ("provider limit/overload (no envelope)")
#    — wait, then `resume`.
# 4. UNHASHED INSTRUCTION CHANNEL. Copilot reads repo instruction files
#    (.github/copilot-instructions.md and friends) into every spawn — same
#    class as claude's CLAUDE.md and pi's AGENTS.md discovery above. No
#    verified off switch is pinned here: treat those files as part of every
#    prompt that `explain` cannot see, and keep node rules in personas/ and
#    spec.context, which are hashed.
#
# prompt_via stays "argv" only because stdin prompting is UNVERIFIED on
# copilot; if your build reads a piped prompt, switch to "stdin" — corrective
# re-spawn prompts are several times the original and Windows caps a command
# line near 32k (`verify --lint` warns; ArgvTooLong fails cleanly).
# No JSON mode: these nodes report `no envelope` in cost views, permanently.
[executors.copilot-cli]
argv = ["copilot", "-p", "{prompt}"]
prompt_via = "argv"
default_retry = { max = 0 }

# A LOCAL model — no network, no credential, no token cost. `ollama run` has no
# file tools at all, so nodes on this stanza answer on the §8.3 stdout channel
# and a shell node writes the file (`contrib/save_result.py`). Omitting
# `json_field` is what tells the driver this harness speaks RAW stdout, which
# is what keeps an `output: "text"` node's source code intact. Prompts go via
# stdin: Windows caps a command line near 32k and a source file in a prompt
# reaches that quickly. Worked example: flows/demo/sudoku-local.tg.json.
[executors.local-coder]
argv = ["ollama", "run", "qwen2.5-coder:14b", "--nowordwrap", "{prompt}"]
prompt_via = "stdin"

# THE MODEL IS PER NODE, NOT PER FLOW. One stanza per model; a node picks with
# `spec.executor`, and nothing else in the flow changes. Here the same local
# models reached through pi, which lists ollama as a provider — so this costs
# nothing either, and a flow can mix harnesses as freely as it mixes models.
# flows/demo/sudoku-local.tg.json runs its solver on the 35B (the job that
# needs it) and its CLI on a 14B through pi (the job that does not).
[executors.local-coder-big]
argv = ["ollama", "run", "qwen3.6:35b", "--nowordwrap", "--hidethinking", "{prompt}"]
prompt_via = "stdin"

[executors.pi-coder]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills",
        "--provider", "ollama", "--model", "qwen2.5-coder:14b", "{prompt}"]
prompt_via = "stdin"          # not argv: a corrective re-spawn's prompt is several times
                              # the original and Windows caps a command line near 32k


# A node whose input is INTERPOLATED needs no tools at all. That collapses an
# agent loop into a single request, which is the largest saving available on a
# request-metered subscription — bigger than any model choice.
#
# `--no-tools` means there is no write tool, so the answer can only come back
# on stdout — which is why `--mode json` must NOT be here. It was, and the
# stanza could not return a result at all: the driver read pi's own
# `{"type":"agent_settled"}` event as the answer. Same rule as `pi-review`
# above: the stdout channel and `--mode json` cannot coexist.
[executors.pi-reasoner]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills",
        "--no-tools", "{prompt}"]
prompt_via = "stdin"

# The in-harness scope guard, attached PER NODE from the argv. `--extension` is
# how pi 0.83.0 loads one (a `.pi/extensions/` drop-in was not discovered), and
# argv is the better place for it anyway: it shows up in the recorded spawn, it
# is per stanza rather than per repo — ADDENDUM-A preamble note 2's granularity
# complaint — and it folds into the stanza digest, so attaching or removing the
# guard re-bills exactly the nodes whose enforcement changed.
# It blocks writes outside the node's declared `spec.writes`; a node that
# declares none is unaffected.
#
# A WRITER stanza, like `pi` — the guard's whole subject is `spec.writes`, and
# a readonly node has none. So no readonly_argv here either, for the same
# reason and with the same loud `readonly-unenforced` failure if you try.
[executors.pi-guarded]
argv = ["pi", "-p", "--mode", "json", "--no-session",
        "--no-context-files", "--no-skills",
        "--extension", "contrib/pi-extension/lockstep-guard.ts", "{prompt}"]
prompt_via = "stdin"

# --- LOCAL MODELS, TOOL-LESS ---------------------------------------------------
# Used by flows/demo/webapp-local.tg.json. `pi.cmd` on Windows; `pi` elsewhere.
#
# `--no-tools` is not a safety flourish, it is the only shape that WORKS. Probed
# against pi 0.83.0 + ollama on 2026-08-09:
#
#     qwen2.5-coder:7b  --tools read : answered with a HALLUCINATED TOOL CALL
#                                      ({"name":"read","arguments":{...}}) as its
#                                      result text -- unusable on any channel
#     qwen2.5-coder:7b  --no-tools   : clean, correct JSON in 3s
#     qwen2.5-coder:14b --no-tools   : clean, correct JSON in 27s
#
# Small models narrate tool calls into the result channel. Give them none, put
# everything they need in the prompt, and let shell nodes do the file I/O
# (`contrib/save_result.py`). That is also the §8.3 stdout-channel shape.
#
# readonly_argv repeats `--no-tools` deliberately. The enforcement is already in
# the base argv -- which is what SPEC §6.11 asks for, argv-visible rather than
# asked-for-in-the-prompt -- and declaring it here is what makes
# `spec.readonly: true` legal on these stanzas. That flag is worth having twice
# over: it drops the `tree` token so the writers fan out, and it swaps the
# standard footer for FOOTER_READONLY, which stops the driver telling a model
# with no tools to go and write a result file it cannot write.

[executors.local-fast]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills", "--no-tools",
        "--provider", "ollama", "--model", "qwen2.5-coder:7b", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--no-tools"]

[executors.local-smart]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills", "--no-tools",
        "--provider", "ollama", "--model", "qwen2.5-coder:14b", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--no-tools"]

# The algorithm node of webapp-local needs more capacity than the mechanical
# ones. Measured: qwen2.5-coder:14b cycled across three heal rounds on the
# settlement loop (two wrong answers and one infinite loop); the 7B is fine for
# the files that are mostly boilerplate. THE MODEL IS PER NODE - that is the
# whole point of spec.executor.
[executors.local-strong]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills", "--no-tools",
        "--provider", "ollama", "--model", "mistral-small:24b", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--no-tools"]

# The bakeoff model. `contrib/demo/model_bakeoff.py` put the real write-logic
# prompt through every model on this machine and this was the ONLY one that
# passed the settlement gate first try, in 90s:
#
#   qwen3.6:35b        PASS    90s
#   mistral-small:24b  block   49s   settle returned no transfers
#   qwen2.5-coder:14b  block   18s   SyntaxError
#   gemma4:12b         block  108s   settle leaves 10.00 unsettled
#   qwen2.5-coder:7b   block    7s   payer never debited as a participant
#   qwen3.5:9b         block   23s   SyntaxError
#
# It is 23 GB against 16 GB of VRAM, so roughly a third of it runs on the CPU —
# and 90s is still cheap for the one node in the flow that has to be right.
# That is the argument for `spec.executor` in one table.
[executors.local-best]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills", "--no-tools",
        "--provider", "ollama", "--model", "qwen3.6:35b", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--no-tools"]

# gemma4:26b is the best generalist on this machine: it passes the settlement,
# the API and the frontend gates (179s / 127s / 94s). 17 GB against 16 GB of
# VRAM, so a little CPU offload. Used for the frontend nodes, where the 7B
# cannot produce a module and the 14B forgets two-decimal formatting.
[executors.local-mid]
argv = ["pi.cmd", "-p", "--no-session", "--no-context-files", "--no-skills", "--no-tools",
        "--provider", "ollama", "--model", "gemma4:26b", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--no-tools"]

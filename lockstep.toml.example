# lockstep executor config (SPEC §8.2). An executor entry is an argv template:
# a new harness or a renamed flag is a config edit, never a code change.
# VERIFY flag names against your installed harness (`claude --help` etc.) and
# pin here; `lockstep doctor` checks each stanza actually runs. Run doctor after
# any harness upgrade and on a weekly cadence.
#
# New to driving lockstep (human or agent)? Read, in order:
#   docs/guides/DRIVING-LOCKSTEP.md    - the drive loop, exit-code protocol, run-dir
#                                 diagnosis; paste-ready for your AGENTS.md
#   docs/guides/FLOW-AUTHORING.md      - how to write a *.tg.json (node model,
#                                 verifier trip-wires, interpolation, heal)
#   flows/starter/README.md     - seven verified template flows + caveats
# Authoritative spec: docs/spec/SPEC.md + AMENDMENTS r4-r6 (later wins);
# pi extension rules: docs/spec/ADDENDUM-A-pi-hooks.md.

default = "claude-code"

[executors.claude-code]                    # personal machine, Claude subscription
argv = ["claude", "-p", "{prompt}", "--output-format", "json"]
prompt_via = "argv"                        # "argv" | "stdin"
json_field = "result"                      # unwrap this envelope field; omit for raw
persona_flag = []                          # empty => prepend persona body to the prompt
readonly_argv = ["--disallowed-tools", "Edit,Write"]   # appended for spec.readonly nodes;
                                           # absent => readonly nodes error at verify

[executors.pi]                             # work machine: pi carries the Copilot login
# pi >= 0.81: JSON output is `--mode json`. `--no-session` keeps doctor probes
# out of the session store; for audit-lineage capture (ADDENDUM-A A.3.4) use
# `"--session-dir", "{phase_dir}"` instead — {phase_dir} expands at spawn (and
# in doctor probes) and stays out of input_hash. Sanctioned only if your pi
# version starts a FRESH session per -p spawn, never resuming from that dir —
# verify after upgrades (ADDENDUM-A preamble note 1). Every spawn also exports
# LOCKSTEP_NODE_ID / _ROLE / _WORKSPACE_SCOPE / _WRITE_SCOPE / _VERDICT_FILE /
# _PHASE_DIR / _CONTRACT / _REPO_ROOT for in-harness enforcement extensions
# (contrib/pi-extension/lockstep-guard.ts). _WRITE_SCOPE is spec.writes as a
# JSON array; _REPO_ROOT is what those relative globs resolve against — an
# extension that resolves them against cwd instead blocks nothing.
argv = ["pi", "-p", "--mode", "json", "--no-session", "{prompt}"]
prompt_via = "stdin"                       # not argv: a corrective re-spawn's prompt is
                                           # several times the original and Windows caps
                                           # a command line near 32k (verify --lint says so)
# NO readonly_argv HERE, DELIBERATELY — use `pi-review` below for readonly
# nodes. `--mode json` and the §8.3 STDOUT channel are mutually exclusive, and
# a readonly node has only the stdout channel (FOOTER_READONLY tells it to
# answer in its final response; the tool allowlist removes the write tool it
# would need for a result file).
#
# Measured against pi 0.83.0: `--mode json` is an event STREAM, not one
# envelope. 72 lines of JSONL for a one-word answer, the last of which is
# `{"type":"agent_settled"}` — and that is exactly what the driver's
# `extract_last_json` returns. A readonly `output: "json"` node would validate
# pi's own terminal event against its contract, fail, spend its one corrective
# re-spawn, and fail the node. Writers are unaffected: they answer in
# `result.json` and the file channel wins before stdout is ever read.
#
# Omitting readonly_argv here is what turns that into a LOUD failure: a
# readonly node pointed at this stanza fails `verify` with `readonly-unenforced`
# — free, before anything spawns — instead of failing at runtime after paying
# for the spawn.

# THE READONLY STANZA. Same binary, same model — the ONE difference is that
# `--mode json` is gone, which is what leaves stdout clean enough to be the
# §8.3 result channel. Point every judgement node at this: reviewers,
# arbiters, triage, estimation, planning.
#
# TOOLS ARE PART OF THE STANZA. pi's `--tools` is an argv-visible allowlist,
# which is exactly what SPEC §6.11 requires of readonly enforcement — so
# `spec.readonly: true` is legal on pi, which ADDENDUM-A preamble note 3 had
# parked as an r7 candidate. Verified against pi 0.83.0 with a control:
# unrestricted the model created the file; with the allowlist it did not, while
# still replying "DONE". The allowlist covers EXTENSION tools too, so name
# `submit_result` or the guard extension's own tool disappears; naming a tool
# that is not installed is harmless. grep/find/ls are OFF by default in pi and
# the allowlist turns them ON.
#
# Two things this buys beyond safety: readonly nodes drop the `tree` token, so
# reviewers fan out in parallel instead of queueing; and on a request-metered
# plan a node that cannot edit cannot spend a round trip trying to.
#
# The price, stated honestly: no `--mode json` means no usage envelope, so
# these nodes report `no envelope` in the cost views. Task counts and wall time
# still work. Removing that trade needs the driver to understand pi's event
# stream on the RESULT path (it already does on the cost path — see
# `contrib/cost-fields.toml.example`, `format = "pi-stream"`); until then,
# telemetry on reviewers costs correctness, and correctness wins.
[executors.pi-review]
argv = ["pi", "-p", "--no-session", "{prompt}"]
prompt_via = "stdin"
readonly_argv = ["--tools", "read,grep,find,ls,submit_result"]

[executors.copilot-cli]
argv = ["copilot", "-p", "{prompt}"]
prompt_via = "argv"

# A LOCAL model — no network, no credential, no token cost. `ollama run` has no
# file tools at all, so nodes on this stanza answer on the §8.3 stdout channel
# and a shell node writes the file (`contrib/save_result.py`). Omitting
# `json_field` is what tells the driver this harness speaks RAW stdout, which
# is what keeps an `output: "text"` node's source code intact. Prompts go via
# stdin: Windows caps a command line near 32k and a source file in a prompt
# reaches that quickly. Worked example: flows/demo/sudoku-local.tg.json.
[executors.local-coder]
argv = ["ollama", "run", "qwen2.5-coder:14b", "--nowordwrap", "{prompt}"]
prompt_via = "stdin"

# THE MODEL IS PER NODE, NOT PER FLOW. One stanza per model; a node picks with
# `spec.executor`, and nothing else in the flow changes. Here the same local
# models reached through pi, which lists ollama as a provider — so this costs
# nothing either, and a flow can mix harnesses as freely as it mixes models.
# flows/demo/sudoku-local.tg.json runs its solver on the 35B (the job that
# needs it) and its CLI on a 14B through pi (the job that does not).
[executors.local-coder-big]
argv = ["ollama", "run", "qwen3.6:35b", "--nowordwrap", "--hidethinking", "{prompt}"]
prompt_via = "stdin"

[executors.pi-coder]
argv = ["pi.cmd", "-p", "--no-session", "--provider", "ollama", "--model", "qwen2.5-coder:14b", "{prompt}"]
prompt_via = "stdin"          # not argv: a corrective re-spawn's prompt is several times
                              # the original and Windows caps a command line near 32k


# A node whose input is INTERPOLATED needs no tools at all. That collapses an
# agent loop into a single request, which is the largest saving available on a
# request-metered subscription — bigger than any model choice.
#
# `--no-tools` means there is no write tool, so the answer can only come back
# on stdout — which is why `--mode json` must NOT be here. It was, and the
# stanza could not return a result at all: the driver read pi's own
# `{"type":"agent_settled"}` event as the answer. Same rule as `pi-review`
# above: the stdout channel and `--mode json` cannot coexist.
[executors.pi-reasoner]
argv = ["pi.cmd", "-p", "--no-session", "--no-tools", "{prompt}"]
prompt_via = "stdin"

# The in-harness scope guard, attached PER NODE from the argv. `--extension` is
# how pi 0.83.0 loads one (a `.pi/extensions/` drop-in was not discovered), and
# argv is the better place for it anyway: it shows up in the recorded spawn, it
# is per stanza rather than per repo — ADDENDUM-A preamble note 2's granularity
# complaint — and it folds into the stanza digest, so attaching or removing the
# guard re-bills exactly the nodes whose enforcement changed.
# It blocks writes outside the node's declared `spec.writes`; a node that
# declares none is unaffected.
#
# A WRITER stanza, like `pi` — the guard's whole subject is `spec.writes`, and
# a readonly node has none. So no readonly_argv here either, for the same
# reason and with the same loud `readonly-unenforced` failure if you try.
[executors.pi-guarded]
argv = ["pi", "-p", "--mode", "json", "--no-session",
        "--extension", "contrib/pi-extension/lockstep-guard.ts", "{prompt}"]
prompt_via = "stdin"
